root = true

# Default settings for all files
[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Arduino (.ino) and C++ files
[*.{ino,cpp,hpp,h,c}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# JSON/YAML (platformio.ini用)
[*.{json,yaml,yml,ini}]
indent_style = space
indent_size = 2
